+def delivered_failure(services, row, ordinal, action, observation):
+    reason = tool_failure_reason(observation)
+    if not reason:
+        raise ValueError('healthy_tool_is_not_failed')
+    if observation.get('status') not in ('failed', 'error', 'completed'):
