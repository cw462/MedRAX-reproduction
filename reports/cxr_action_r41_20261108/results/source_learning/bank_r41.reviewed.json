  "source_sha256": "a0e82f405964f62b466ed1d24096555981cc9ae1d516abd6f7b252ba7ff24de9",
  "items": [
    {
      "kind": "task",
      "id": "16841",
      "source_ids": [
        "16841"
      ],
      "topic": "Temporal comparison of pulmonary opacities and residual findings in serial CXR",
      "tasks": [
        "comparison",
        "location",
        "morphology"
      ],
      "requires_pair": true,
      "required_question_terms": [
        "evolution",
        "progression",
        "changes",
        "initial",
        "discharge",
        "Case 1",
        "Case 2"
      ],
      "actions": [
        {
          "observe": "Compare the density and extent of parenchymal opacities in the initial vs. follow-up images for each case. Specifically check if peripheral consolidations have cleared to reveal linear/basal atelectatic streaks (resolution) versus persistent ill-defined opacities (ongoing inflammation).",
          "tool": "none",
          "when": "Question asks for evolution/progression between two timepoints or cases.",
          "stop": "When the change in opacity pattern (clearing vs. persistence) and presence/absence of residual linear densities are visually confirmed in the paired images."
        },
        {
          "observe": "Verify the laterality of any residual basal findings (e.g., left vs. right basal zone) in the follow-up image to distinguish between similar options describing resolution patterns.",
          "tool": "image_visualizer",
          "when": "Options differ only by the side (left/right) of residual atelectasis or specific zone involvement.",
          "stop": "When the specific lung base containing linear opacities is identified."
        }
      ],
      "avoid": "Inferring disease progression or severity solely from chest_xray_classifier scores, as they are not calibrated for longitudinal change. Assuming 'no strong finding' implies normality. Confusing residual atelectasis with active consolidation.",
      "source_evidence": "The model previously failed to identify the specific location of residual atelectasis (confusing right vs. left basal zone in source_id 16841_8143559675148) and mischaracterized the evolution of consolidations (source_id 16841_8143559673400). The correct answer requires distinguishing 'persistent ill-defined opacities' from 'improvement with residual atelectasis' and identifying the precise location (left basal zone) of the residual finding. Classifier tools provided conflicting or non-calibrated scores, confirming that visual comparison of the original paired images is necessary to resolve temporal changes and specific morphological residuals."
    },
    {
      "kind": "task",
      "id": "r41_extent_14923",
      "source_ids": [
        "14923"
      ],
      "topic": "Describe the visible opacity: boundaries, shape, extent and adjacent structures",
      "tasks": [
        "morphology",
        "location",
        "severity",
        "relation"
      ],
      "requires_pair": false,
      "required_question_terms": [],
      "actions": [
        {
          "observe": "Locate the opacity actually asked about; inspect its visible boundaries, shape and extent relative to the corresponding lung zones. Compare every location/extent/margin clause in competing options against that same original.",
          "tool": "none",
          "when": "Only when the current question asks about an opacity or mass and its relevant boundaries are visible. Otherwise ignore this card.",
          "stop": "Stop when the asked attributes are distinguished; if a boundary is obscured, keep that attribute uncertain rather than inferring the whole option."
        },
        {
          "observe": "Check the diaphragm, mediastinal border or other adjacent structure separately for any displacement claimed by an option; do not substitute mass size for evidence of displacement.",
          "tool": "none",
          "when": "Only if adjacent-structure effect is part of the current question or options.",
          "stop": "Record the observed relationship, no displacement or uncertainty; do not assume the source direction or infer histology."
        }
      ],
      "avoid": "A source mass, diagnosis, side and Figure number are not present-patient evidence. Smoothness alone does not establish benignity; an automated negative report does not overrule a visible opacity.",
      "source_evidence": "Source14923 originalFigure1 visibly contains a large bounded lower-hemithorax opacity. Released trajectories distinguish lower-zone extent/margins and mass effect while reports disagree. This supports checking each visible attribute, not transferring the source tumor or direction."
    },
    {
      "kind": "task",
      "id": "r41_bilateral_17158",
      "source_ids": [
        "17158"
      ],
      "topic": "Verify each side and visible count before choosing a combined extent claim",
      "tasks": [
        "count",
        "location",
        "presence"
      ],
      "requires_pair": false,
      "required_question_terms": [],
      "actions": [
        {
          "observe": "Inspect the anatomical feature actually named in the question separately on the patient right and left, using image markers. For a bilateral or multiple claim, require visible support for each included side or distinct item.",
          "tool": "none",
          "when": "When a question or option distinguishes presence, unilateral/bilateral involvement or a visible count. Inspect only the asked feature; ignore unrelated source pathology.",
          "stop": "Stop after each required side/item is assessed; overlapping, hidden or indeterminate regions do not count as absent or present."
        },
        {
          "observe": "For relative extent claims, compare the same feature on corresponding sides instead of assigning a fixed source-dominant side.",
          "tool": "none",
          "when": "Only when the current question asks asymmetry or relative extent and both regions are adequately shown.",
          "stop": "Stop with observed asymmetry, symmetry or uncertainty; avoid numerical volume estimates without valid measurements."
        }
      ],
      "avoid": "A finding on one side does not establish a bilateral answer. Do not transplant septic emboli, cavitation, effusion or a dominant side from the source.",
      "source_evidence": "Source17158 Figure1 and released trajectories separately describe nodular features and asymmetric pleural findings; arrows and denser left-base opacity are visible. The transferable action is independent side/extent verification, not the etiology or a required positive result."
    },
    {
      "kind": "task",
      "id": "r41_relation_9057",
      "source_ids": [
        "9057"
      ],
      "topic": "Trace the trachea and determine its relationship to visible mediastinal contours",
      "tasks": [
        "relation",
        "location"
      ],
      "requires_pair": false,
      "required_question_terms": [
        "trachea"
      ],
      "actions": [
        {
          "observe": "Trace the visible tracheal air column relative to spinal midline and inspect mediastinal contour separately; consider rotation before assigning a direction.",
          "tool": "none",
          "when": "Only when the current question explicitly asks tracheal position/deviation and the relevant landmarks are visible.",
          "stop": "Stop with leftward, rightward, no clear deviation or indeterminate position; do not require a contralateral shift."
        },
        {
          "observe": "Match any claimed contour side and tracheal direction as separate clauses of an option.",
          "tool": "none",
          "when": "Only if the current options combine a mediastinal contour finding and displacement.",
          "stop": "Stop when both clauses are supported or one remains uncertain; size alone does not prove deviation."
        }
      ],
      "avoid": "No source right-sided mass, leftward direction or etiologic diagnosis transfers. Generic automated normal-contour text is not an anatomical measurement.",
      "source_evidence": "Source9057 original CXR and released trajectories contrast upper-mediastinal contour laterality with tracheal direction; previous answers reversed that relationship. This supports tracing both structures independently."
    },
    {
      "kind": "task",
      "id": "r41_volume_9374",
      "source_ids": [
        "9374"
      ],
      "topic": "Assess visible lung volume with acquisition limitations",
      "tasks": [
        "severity",
        "view",
        "morphology"
      ],
      "requires_pair": false,
      "required_question_terms": [
        "volume"
      ],
      "actions": [
        {
          "observe": "Inspect diaphragm configuration and overall lung expansion alongside visible parenchymal texture. Check whether acquisition, inspiration or obscuration limits the comparison claimed by options.",
          "tool": "none",
          "when": "Only when the current question explicitly asks lung volume and the relevant diaphragms/lung fields are shown.",
          "stop": "Stop with the visible expansion/texture description or uncertainty; do not diagnose restrictive physiology from one low-volume image or count ribs using a rigid threshold."
        }
      ],
      "avoid": "Do not use the source rib-count thresholds, infer pulmonary-function results, force an obstructive/restrictive diagnosis, or treat a classifier score as volume/severity.",
      "source_evidence": "Source9374 Figure1 shows relatively low expansion and coarse markings; released source options contrast low versus high volume while automated text disagrees. Only qualitative image description with acquisition limits is retained. Original R4.1 source binding rejection remains recorded; this separate source-reviewed card has explicit case9374 provenance."
    },
    {
      "kind": "task",
      "id": "r41_margins_15697",
      "source_ids": [
        "15697"
      ],
      "topic": "Characterize a questioned nodule margin without assigning its etiology",
      "tasks": [
        "morphology"
      ],
      "requires_pair": false,
      "required_question_terms": [
        "nodule"
      ],
      "actions": [
        {
          "observe": "Locate the nodule named by the current question. Inspect margin definition and shape as separate attributes: clear versus indistinct boundary and smooth/round versus irregular/lobulated outline.",
          "tool": "none",
          "when": "Only when the current question explicitly asks about a nodule and the boundary is adequately visible.",
          "stop": "Stop when the asked attributes are supported or remain indeterminate; shape plus margin alone does not prove a vascular or malignant origin."
        }
      ],
      "avoid": "Do not copy the source Figure, side, PAVM label or preferred option. No positive finding is required; invisible detail is not evidence of smoothness or absence.",
      "source_evidence": "Source15697 frontal original and released trajectory distinguish sharp margins from shape terminology while an old answer conflated them. The revised card retains separate morphology observation and removes etiologic inference."
    },
    {
      "kind": "task",
      "id": "r41_compare_16841",
      "source_ids": [
        "16841"
      ],
      "topic": "Compare corresponding opacity regions in explicitly bound serial originals",
      "tasks": [
        "comparison"
      ],
      "requires_pair": true,
      "required_question_terms": [],
      "actions": [
        {
          "observe": "Bind the supplied originals to explicit patient/time labels, then compare corresponding regions for opacity extent/density and residual features. Assess each case separately if more than one patient is shown.",
          "tool": "none",
          "when": "Only for an explicit comparison question with at least two appropriate originals and unambiguous patient/time binding.",
          "stop": "Stop with increased, decreased, unchanged or indeterminate findings for each asked region. If chronological binding is absent or projections prevent comparison, do not infer change."
        },
        {
          "observe": "Verify the side of any residual finding independently from whether its extent improved.",
          "tool": "none",
          "when": "Only if current options combine temporal change with residual location.",
          "stop": "Stop after both clauses are checked; neither source clearing nor source side is the expected answer."
        }
      ],
      "avoid": "Do not infer chronology from file order, disease progression from classifier scores or one report, or transfer the source recovery trajectory.",
      "source_evidence": "Source16841 Figures1/13/14/15 and released trajectories contain distinct opacity and residual-location comparisons across cases. The general revision retains the necessary paired/explicit-binding condition and removes fixed outcomes; the unchanged original card remains separately restricted."
    }
  ],
