{
  "rules": {
    "allowed_fields": [
      "age",
      "gender",
      "history"
    ],
    "excluded_fields": [
      "title",
      "diagnosis",
      "differential_diagnosis",
      "image_finding",
      "discussion"
    ],
    "risk_terms": [
      "radiograph",
      "radiographic",
      "x-ray",
      "xray",
      "ct",
      "computed tomography",
      "mri",
      "ultrasound",
      "opacity",
      "opacities",
      "mass",
      "effusion",
      "nodule",
      "shadow",
      "consolidation",
      "infiltrate",
      "pneumothorax"
    ],
    "diagnosis_overlap": {
      "processor": "isolated_pre_run_flagger_only",
      "tokenizer": "ASCII alphabetic words, casefold, length >= 4",
      "stopwords": [
        "about",
        "after",
        "also",
        "been",
        "before",
        "being",
        "both",
        "case",
        "could",
        "during",
        "from",
        "have",
        "into",
        "most",
        "other",
        "patient",
        "patients",
        "present",
        "presented",
        "showed",
        "showing",
        "some",
        "such",
        "than",
        "that",
        "their",
        "there",
        "these",
        "they",
        "this",
        "through",
        "under",
        "very",
        "were",
        "which",
        "with",
        "without",
        "would",
        "year",
        "years",
        "history",
        "clinical"
      ],
      "output": [
        "case_id",
        "flagged",
        "rule_codes"
      ],
      "diagnosis_to_generation": false
    },
    "freeze_before_calls": true,
    "history_gate": "overall and unflagged-subset paired CI lower bounds > 0",
    "minimum_unflagged_cases": 2
  },
