},\n  \"checklists\": [\n    \"Confirm whether the initial global read contradicts the question's implied finding; if so, escalate to localization tools.\",\n    \"Verify each answer option was probed separately and that the chosen option has positive localized evidence while the alternative does not.\"\n  ]\n}\n```"},"finish_reason":"stop","logprobs":null}],"usage":{"prompt_tokens":561,"total_tokens":945,"completion_tokens":384,"prompt_tokens_details":{"cached_tokens":0,"image_tokens":0,"text_tokens":561},"completion_tokens_details":{"text_tokens":384}}}